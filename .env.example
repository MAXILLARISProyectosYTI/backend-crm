# --- Servidor ---
NODE_ENV=development
# Puerto HTTP del CRM (sin PORT usa 8990). En local usamos 5432.
PORT=5432
CORS_ORIGIN=

# --- Base de datos del CRM (PostgreSQL) ---
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=crm

# --- Base de datos de SV (lectura directa, opcional) ---
SV_DB_HOST=
SV_DB_PORT=5432
SV_DB_USERNAME=
SV_DB_PASSWORD=
SV_DB_DATABASE=

# --- Seguridad ---
JWT_SECRET=
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=
INTERNAL_API_KEY=
INTERNAL_CRM_API_KEY=
SV_AUTH_ORIGIN=crm
SV_BRIDGE_USER_NAME=
USERNAME_ADMIN=
PASSWORD_ADMIN=

# --- Back de SV (sv-backend-main, puerto 5533 en local) ---
URL_BACK_SV=http://localhost:5533/api
URL_DOWNLOAD_FILES=http://localhost:5533/
URL_INVOICE_MIFACT_V3=http://localhost:5533/api
INVOICE_MIFACT_USERNAME=
INVOICE_MIFACT_PASSWORD=
SV_CRM_CONTROLES_PATH=
SV_CRM_CONTROLES_TIMEOUT_MS=

# --- Backend de agenda (wsk-schedule-backend, puerto 3606 en local) ---
URL_SCHEDULE_BACKEND=http://localhost:3606

# --- Sin version local ---
# Servidor de archivos: en produccion es otro servicio; sin el, fallan las funciones de archivos
URL_FILES=
URL_FRONT_MANAGER_LEADS=https://crm.maxillaris.pe/

# --- Tareas programadas (opcionales) ---
CRM_CONTROLES_CRON=
CRM_CONTROLES_FACTURACION_CRON=
CRM_CONTROLES_REPROG_CRON=
CRM_CONTROLES_SESSIONS_CRON=
CRM_CONTROLES_SNAPSHOT_CRON=
CRM_CONTROLES_BOOT_SYNC_DELAY_MS=
CRM_OI_FACTURACION_CRON=
CRM_REFERRAL_CASHBACK_EXPIRE_CRON=
OPPORTUNITY_CIERRE_GANADO_SYNC_CRON_ENABLED=
DOCUSEAL_PRODUCTION_DATE=
